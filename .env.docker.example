# Copy to `.env` (next to docker-compose.yml) and adjust.

# Port the site is served on.
WEB_PORT=8080
# Where the site will be reached from, for CORS on direct API calls.
PUBLIC_URL=http://localhost:8080

# "ollama" runs agents on the bundled local model; "anthropic" uses the API.
LLM_PROVIDER=ollama
ANTHROPIC_API_KEY=

# Must support tool calling. On a small CPU-only server, qwen3.5:4b is
# noticeably faster than qwen2.5:7b.
OLLAMA_MODEL=qwen2.5:7b

# Optional: reuse models already downloaded on this machine instead of
# pulling them again. Point at the folder that contains `blobs/` and `manifests/`.
# OLLAMA_MODELS_DIR=C:/Users/eddie/video_retrieval_temporal_search_v2/codefour_task/local_data/ollama_models
